@{
    ViewData["Title"] = "Password Reset Email Sent";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Check Your Email</h1>
            <p>If an account with that email exists, we've sent you a password reset link. Please check your inbox.</p>
        </div>

        <div class="auth-links">
            <a asp-action="Login" class="link-primary">Return to Sign In</a>
        </div>
    </div>
</div>

