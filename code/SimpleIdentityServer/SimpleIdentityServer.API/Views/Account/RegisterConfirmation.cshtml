@{
    ViewData["Title"] = "Registration Confirmation";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Check Your Email</h1>
            <p>We've sent you a confirmation email. Please check your inbox and click the confirmation link to activate your account.</p>
        </div>

        <div class="auth-links">
            <a asp-action="Login" class="link-primary">Return to Sign In</a>
        </div>
    </div>
</div>

