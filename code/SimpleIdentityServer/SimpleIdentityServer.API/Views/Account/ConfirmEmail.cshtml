@{
    ViewData["Title"] = "Email Confirmed";
    Layout = "_AuthLayout";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Email Confirmed</h1>
            <p>Your email has been confirmed successfully. You can now sign in to your account.</p>
        </div>

        <div class="auth-links">
            <a asp-action="Login" class="link-primary">Sign In</a>
        </div>
    </div>
</div>

